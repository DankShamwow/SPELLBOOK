; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SPELLBOOK"
run/main_scene="uid://xhd3gu2e1guy"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

StartingTiles="*res://TILE/StartingTiles.gd"
GeneralManager="*res://GENERAL/GeneralManager.gd"
WordListManager="*res://WORDLISTS/WordListManager.gd"
RandomStartingTiles="*res://TILE/RandomStartingTiles.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://COMBAT/": "red",
"res://GENERAL/": "pink",
"res://OLD_BAD/": "gray",
"res://RELIC/": "blue",
"res://SPRITES/": "yellow",
"res://TILE/": "orange",
"res://WORDLISTS/": "green"
}

[gui]

theme/custom_font="uid://dbl8tpudhrqen"

[rendering]

textures/canvas_textures/default_texture_filter=0
